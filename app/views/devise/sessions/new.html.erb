<div class="how-to-play">
  <h1>ログイン</h1>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="auth-field">
      <%= f.label :email, "メールアドレス" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "auth-input" %>
    </div>

    <div class="auth-field">
      <%= f.label :password, "パスワード" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "auth-input" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="auth-field auth-field--checkbox">
        <%= f.check_box :remember_me %>
        <%= f.label :remember_me, "ログイン状態を保持する" %>
      </div>
    <% end %>

    <div class="auth-actions">
      <%= f.submit "ログイン", class: "btn btn--primary" %>
    </div>
  <% end %>

  <div class="auth-links">
    <%= render "devise/shared/links" %>
  </div>

  <div class="how-to-play__buttons">
    <%= link_to "トップへ戻る", root_path, class: "btn btn--secondary" %>
  </div>
</div>
