<div class="how-to-play">
  <h1>新しいパスワードの設定</h1>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <div class="auth-field">
      <%= f.label :password, "新しいパスワード" %>
      <% if @minimum_password_length %>
        <em class="auth-hint">(<%= @minimum_password_length %>文字以上)</em>
      <% end %>
      <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "auth-input" %>
    </div>

    <div class="auth-field">
      <%= f.label :password_confirmation, "新しいパスワード（確認用）" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "auth-input" %>
    </div>

    <div class="auth-actions">
      <%= f.submit "パスワードを変更する", class: "btn btn--primary" %>
    </div>
  <% end %>

  <div class="auth-links">
    <%= render "devise/shared/links" %>
  </div>
</div>
