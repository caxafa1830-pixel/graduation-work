<!DOCTYPE html>
<html>
  <head>
    <title>シーバスカップ</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <% if user_signed_in? %>
        <span class="site-header__user"><%= current_user.email %> でログイン中</span>
        <%= link_to "捕獲記録", catch_records_path, class: "btn btn--secondary btn--small" %>
        <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "btn btn--secondary btn--small" %>
      <% else %>
        <%= link_to "ログイン", new_user_session_path, class: "btn btn--secondary btn--small" %>
        <%= link_to "会員登録", new_user_registration_path, class: "btn btn--primary btn--small" %>
      <% end %>
    </header>

    <% if notice %>
      <p class="flash flash--notice"><%= notice %></p>
    <% end %>
    <% if alert %>
      <p class="flash flash--alert"><%= alert %></p>
    <% end %>

    <%= yield %>
  </body>
</html>
